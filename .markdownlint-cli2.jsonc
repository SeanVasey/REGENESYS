// markdownlint-cli2 configuration
// https://github.com/DavidAnson/markdownlint-cli2#markdownlint-cli2jsonc
{
  "config": {
    // Disable line-length rule — long lines are common in docs and
    // CLAUDE.md-style instruction files. This is the #1 cause of
    // recurring markdown lint failures in this repo.
    "MD013": false,

    // Allow inline HTML when needed (badges, images with sizing, etc.)
    "MD033": false,

    // Allow duplicate headings in different sections (e.g., multiple
    // "### Example" under different parent headings)
    "MD024": { "siblings_only": true },

    // Allow trailing punctuation in headings (e.g., "Security (OWASP Top 10 mindset)")
    "MD026": { "punctuation": ".,;:!" },

    // Allow first line to be HTML (centered header block in README)
    "MD041": false,

    // Disable table column style enforcement — pipes without extra spacing
    // are valid and more readable for compact tables
    "MD060": false
  },

  // Ignore generated / third-party files
  "ignores": [
    "node_modules/**",
    ".git/**"
  ]
}
